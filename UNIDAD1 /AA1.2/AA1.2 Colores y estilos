function setup() {
  createCanvas(400, 400);
}

function draw() {
  background(220);
  
  fill (100,255, 50)// cambio de relleno y color 
  stroke (255,0,0)
  rect(100,100,200,200)
  //contorno ojos 
  fill(255,0 ,0)
  strokeWeight (4) /
  ellipse (150, 160, 40, 40)
  ellipse (250, 160, 40, 40)
  //pupilas
  noStroke()
  fill(0)
  ellipse (150, 160, 15, 15)
  ellipse (250, 160, 15, 15)
  stroke(0)
  strokeWeight (4)
  line(150 ,240, 250, 240)

  // la naris hueca o sin relleno 

  noFill()
  strokeWeight (2)
  triangle(200, 180, 185, 210, 215, 210)
  
}
